bool kzOn      = input.bool(true, "Kill-zone shading", group = SES, tooltip = "Single ultra-subtle neutral tint while a kill zone is active.")
string sAsia   = input.session("2000-0000", "Asia session (ET)", group = SES)
string sLdn    = input.session("0200-0500", "London KZ (ET)", group = SES)
