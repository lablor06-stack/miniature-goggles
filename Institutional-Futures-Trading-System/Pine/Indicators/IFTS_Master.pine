//@version=6
// ═══════════════════════════════════════════════════════════════════════════════════════════════
//  IFTS — INSTITUTIONAL FUTURES TRADING SYSTEM · MASTER INDICATOR
//  Version 2.0.0 · Pine Script v6 · Target: CME index futures (ES/NQ), chart TF M1–H1
//
//  v2.0.0 — full audit rewrite (see Documentation/05_v2_Audit_Report.md):
//    · display-priority system (Focus / Standard / Analysis) — show only what earns its pixels
//    · smart visualization: consumed liquidity and dead zones are REMOVED, not accumulated
//    · dashboard throttled to bar close (was: rebuilt on every realtime tick)
//    · alert system redesigned: 7 actionable alerts (was: 17 granular ones)
//    · signal engine factored (single parametrized implementation per setup)
//    · fixes: regime float division, one-flip-per-zone lifecycle, dead code removed
//
//  Design contract:
//    · events fire on barstate.isconfirmed only (no logical repaint)
//    · request.security always lookahead_off; dated levels from closed periods [1]
//    · clock pinned to America/New_York (DST-safe)
//    · drawings live in capped arrays; every setter na-guarded; retired objects deleted
//    · functions never assign globals: cross-scope state lives in arrays/objects/returns
//    · canonical defaults P1..P17 from Documentation/00_Conventions_and_Specs.md
// ═══════════════════════════════════════════════════════════════════════════════════════════════
indicator("IFTS — Institutional Futures Trading System [Master]", "IFTS Master", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, dynamic_requests = true)

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 1 · CONSTANTS & PALETTE (single source of visual truth)
// ────────────────────────────────────────────────────────────────────────────────────────────────
string NYTZ = "America/New_York"

color COL_BULL  = #26a69a
color COL_BEAR  = #ef5350
color COL_BRK   = #ff9800
color COL_MIT   = #90a4ae
color COL_IFVG  = #ab47bc
color COL_POOL  = #f5b041
color COL_EQ    = #b0bec5
color COL_VWAP  = #2962ff
color COL_AVWAP = #8d6e63
color COL_TXT   = #d7dde3
color COL_DIM   = #78848f

// zone palette resolved once (kind → bg/border)
color ZBG_BULL = color.new(COL_BULL, 84)
color ZBR_BULL = color.new(COL_BULL, 55)
color ZBG_BEAR = color.new(COL_BEAR, 84)
color ZBR_BEAR = color.new(COL_BEAR, 55)
color ZBG_BRK  = color.new(COL_BRK, 84)
color ZBR_BRK  = color.new(COL_BRK, 55)
color ZBG_MIT  = color.new(COL_MIT, 88)
color ZBR_MIT  = color.new(COL_MIT, 62)
color ZBG_IFV  = color.new(COL_IFVG, 84)
color ZBR_IFV  = color.new(COL_IFVG, 55)
color GHOST_BG = color.new(COL_DIM, 94)
color GHOST_BR = color.new(COL_DIM, 85)

int Z_FVG = 1
int Z_OB  = 2
int Z_MIT = 3
int Z_BRK = 4
int Z_IFV = 5

// statistics slots (mutable int array: Pine functions may mutate array contents)
int ST_FVG_TOT  = 0
int ST_FVG_CE   = 1
int ST_FVG_FILL = 2
int ST_FVG_INV  = 3
int ST_FVG_ROK  = 4
int ST_FVG_RTOT = 5
int ST_OB_TOT   = 6
int ST_OB_TOUCH = 7
int ST_OB_ROK   = 8
var array<int> stArr = array.new<int>(9, 0)

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 2 · INPUTS — General · Structure · Liquidity · OB · FVG · Sessions · VWAP · SMT · Dashboard ·
//              Alerts · Performance · Advanced
// ────────────────────────────────────────────────────────────────────────────────────────────────
string GEN = "General"
string dispMode = input.string("Standard", "Display mode", options = ["Focus", "Standard", "Analysis"], group = GEN, tooltip = "FOCUS: execution view — armed setups, MSS, active liquidity, VWAP line only. STANDARD: adds context (BOS, zone labels, key opens, bands). ANALYSIS: everything, including non-qualified CHoCH, retired objects as dimmed ghosts, and the on-chart statistics block.")
bool sigOn      = input.bool(true, "Signal engine (Setup A / B)", group = GEN, tooltip = "Composite signals per the Core Model. Setup A needs the FVG engine; Setup B needs OB and/or FVG engines. Signals implement stack levels 5-6 only: calendar, bias, map and narrative remain the trader's job (Manual).")
bool biasOn     = input.bool(true, "HTF bias filter", group = GEN, tooltip = "External-structure direction on the bias timeframe, with hysteresis. Gates Setup B and colors the dashboard.")
string biasTf   = input.timeframe("240", "Bias timeframe", group = GEN, tooltip = "H4 default per Conventions §3. Use D on hourly execution charts.")
bool regimeOn   = input.bool(true, "Day-regime classifier", group = GEN, tooltip = "Rotation / Trend / Chop heuristic (gap vs prior day, IB extension, VWAP-side persistence, pool acceptance). Advisory: it gates signals, the trader owns the final call.")
bool pdOn       = input.bool(true, "Dealing range (EQ / premium-discount)", group = GEN, tooltip = "Algorithmic dealing range from external swings. Enforces the V6 gate on Setup A entries (long in discount, short in premium).")
bool newsOk     = input.bool(true, "News checked (manual pre-market flag)", group = GEN, tooltip = "Pine has no reliable economic calendar. Tick after completing the pre-market news check; shown on the dashboard as a discipline reminder.")

string MSG = "Market Structure"
bool msOn      = input.bool(true, "Enable structure engine", group = MSG, tooltip = "Swings, BOS, CHoCH, MSS on two scales. Required by: liquidity (EQH/EQL), zones (OB), signals, SMT.")
int  msIntLen  = input.int(3, "Internal swing length (P1)", minval = 2, maxval = 10, group = MSG, tooltip = "Pivot bars each side. Execution-scale structure. Confirmed N bars after the extreme — structural, unavoidable lag.")
int  msExtLen  = input.int(8, "External swing length (P2)", minval = 5, maxval = 25, group = MSG, tooltip = "Dealing-range scale structure. Feeds EQ and premium/discount.")
bool msShowInt = input.bool(true, "Show internal events", group = MSG, tooltip = "MSS always; BOS in Standard+; non-qualified CHoCH only in Analysis.")
bool msShowExt = input.bool(true, "Show external events", group = MSG, tooltip = "External MSS in all modes; external BOS only in Analysis.")

string LIQ = "Liquidity"
bool liqOn   = input.bool(true, "Enable liquidity engine", group = LIQ, tooltip = "Pool map (PDH/PDL, PWH/PWL, session extremes, EQH/EQL) + sweep detection (P6). Required by the signal engine and the sweep statistics.")
bool liqPdw  = input.bool(true, "Daily & weekly pools (PDH/PDL, PWH/PWL)", group = LIQ, tooltip = "From closed periods — stable, no repaint. Rank 1-2 pools: primary targets and sweep sources.")
bool liqSess = input.bool(true, "Session extreme pools (Asia, London)", group = LIQ, tooltip = "Rank 3 pools created when each session closes.")
bool liqShow = input.bool(true, "Draw pool rays", group = LIQ, tooltip = "Dotted rays with source labels. In Focus mode only rank ≤ 2 pools keep their label. Consumed pools are removed automatically (see Performance → swept pool TTL).")

string OBG = "Order Blocks"
bool obOn       = input.bool(true, "Enable OB / Breaker / Mitigation", group = OBG, tooltip = "Last opposite candle before a qualifying displacement break. With a sweep behind it → OB; without → Mitigation (lower quality). Broken OB flips once into a Breaker.")
bool obOnBos    = input.bool(true, "Create OB on internal BOS too", group = OBG, tooltip = "Off = MSS-only OBs (fewer, cleaner). On = also continuation OBs on internal BOS (needed for Setup B stations).")
bool obBodyOnly = input.bool(false, "Refined zones (body only)", group = OBG, tooltip = "Body-only zones are tighter (better R:R, lower hit-rate). RQ-6b measures the trade-off — keep full wick until your journal says otherwise.")

string FVG = "FVG"
bool fvgOn      = input.bool(true, "Enable FVG / IFVG", group = FVG, tooltip = "Three-candle inefficiency, minimum size gated by P5. A filled FVG is removed; a close-through FVG flips once into an IFVG. Setup A entry zones come from here.")
float fvgMinAtr = input.float(0.25, "Minimum size ×ATR14 (P5)", minval = 0.0, step = 0.05, group = FVG, tooltip = "Gaps below this are quote noise. 0.25 default per Conventions.")
bool fvgShowCe  = input.bool(true, "Show CE (50%) line", group = FVG, tooltip = "Consequent encroachment — the default limit-entry level of Setup A.")

string SES = "Sessions"
bool sesOn     = input.bool(true, "Session levels & key opens", group = SES, tooltip = "Midnight open, RTH open, weekly open. Key opens hidden in Focus mode.")
bool kzOn      = input.bool(true, "Kill-zone shading", group = SES, tooltip = "Subtle background tint during London / NY AM / NY PM / lunch. The signal engine only fires inside kill zones regardless of shading.")
string sAsia   = input.session("2000-0000", "Asia session (ET)", group = SES)
string sLdn    = input.session("0200-0500", "London KZ (ET)", group = SES)
string sNyAm   = input.session("0830-1100", "NY AM KZ (ET)", group = SES)
string sLunch  = input.session("1200-1300", "Lunch — no trade (ET)", group = SES)
string sNyPm   = input.session("1330-1600", "NY PM KZ (ET)", group = SES)
string sRth    = input.session("0930-1600", "RTH (ET)", group = SES)
string sIb     = input.session("0930-1030", "Initial Balance (ET)", group = SES)

string VWG = "VWAP"
bool vwOn    = input.bool(true, "Session VWAP (Globex anchor)", group = VWG, tooltip = "Anchored at the 18:00 ET session open. Volume-weighted σ bands (not plain stdev, not ATR).")
bool vwBands = input.bool(true, "±1σ / ±2σ bands", group = VWG, tooltip = "Hidden in Focus mode (VWAP line only). σ-position always available on the dashboard.")
bool vwRthOn = input.bool(false, "RTH VWAP (09:30 anchor)", group = VWG, tooltip = "Secondary cash-flow read. Off by default to reduce line count.")
bool avWOn   = input.bool(true, "AVWAP · weekly open", group = VWG)
bool avMOn   = input.bool(false, "AVWAP · monthly open", group = VWG)
bool avSOn   = input.bool(true, "AVWAP · last external MSS (auto)", group = VWG, tooltip = "Re-anchors when the external structure shifts — the inventory price of the current leg.")
bool avCOn   = input.bool(false, "AVWAP · custom anchor", group = VWG)
int  avCT    = input.time(timestamp("1 Jan 2026 09:30 -0500"), "Custom anchor time", group = VWG)

string SMT = "SMT"
bool smtOn      = input.bool(true, "Enable SMT divergence", group = SMT, tooltip = "Confirmed-pivot divergence vs the correlated symbol at liquidity, gated by returns-correlation regime. Feeds Setup A grading; no standalone alert (by design — it is a confirmation, not a trigger).")
string smtSym   = input.symbol("CME_MINI:NQ1!", "Correlated symbol", group = SMT, tooltip = "ES chart → NQ1!, NQ chart → ES1!.")
float corrMin   = input.float(0.55, "Minimum returns-correlation", minval = 0.0, maxval = 1.0, step = 0.05, group = SMT, tooltip = "Rolling correlation of bar returns (price-level correlation is spuriously ~1). Below the threshold the module stands by — typical of sector-rotation days.")
bool smtAtPools = input.bool(true, "Only at liquidity pools", group = SMT, tooltip = "Divergences in the middle of the range are noise; require a pool within 0.5×ATR.")

string DSH = "Dashboard"
bool dashOn    = input.bool(true, "Show dashboard", group = DSH, tooltip = "Row count follows the display mode: Focus 7 · Standard 11 · Analysis adds the statistics block. Values refresh on bar close (performance).")
string dashPos = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = DSH)
string dashSz  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = DSH)

string ALR = "Alerts"
bool alSetup     = input.bool(true, "Setup A / B alerts (rich payload)", group = ALR, tooltip = "The actionable alerts: all Core-Model conditions already combined (KZ + sweep + MSS + zone + P/D + R:R). Dynamic alert() carries entry/stop/target/grade for webhooks.")
bool alSweep     = input.bool(true, "Qualified sweep in kill zone", group = ALR, tooltip = "The pre-alert: a rank-qualified pool was just swept inside a KZ — get to the screen before the potential MSS. 5-bar cooldown.")
int  alSweepRank = input.int(3, "Max pool rank for sweep alert", minval = 1, maxval = 4, group = ALR, tooltip = "1 = weekly pools only … 4 = include EQH/EQL. Default 3: dated + session pools.")
bool alKz        = input.bool(false, "Kill-zone open", group = ALR, tooltip = "Session wake-up call (London / NY AM start). Off by default.")

string PRF = "Performance"
int  perfDrawLb   = input.int(1000, "Drawing window (bars back)", minval = 200, maxval = 5000, group = PRF, tooltip = "Objects are only created inside this window. Statistics still run over all loaded bars.")
int  perfPoolMax  = input.int(24, "Max pools kept", minval = 8, maxval = 80, group = PRF)
int  perfFvgMax   = input.int(14, "Max FVG zones kept", minval = 4, maxval = 60, group = PRF)
int  perfObMax    = input.int(10, "Max OB-family zones kept", minval = 4, maxval = 40, group = PRF)
int  perfMsMax    = input.int(24, "Max structure drawings kept", minval = 6, maxval = 100, group = PRF)
int  perfSmtMax   = input.int(10, "Max SMT drawings kept", minval = 2, maxval = 40, group = PRF)
int  perfSweptTtl = input.int(20, "Swept pool TTL (bars)", minval = 5, maxval = 200, group = PRF, tooltip = "A swept pool stays visible this long (the Setup-A decision window), then is removed. Analysis mode keeps it as a ghost instead.")
int  perfZoneAge  = input.int(900, "Zone max age (bars)", minval = 100, maxval = 5000, group = PRF, tooltip = "Zones never touched within this window are retired as stale.")

string ADV = "Advanced"
float advDispK    = input.float(1.5, "Displacement body multiple (P4)", minval = 1.0, step = 0.1, group = ADV, tooltip = "Body ≥ K × 20-bar average body qualifies a break as MSS. Sensitivity grid in Testing/03 — defaults sit on a plateau, do not spike-optimize.")
bool advCluster   = input.bool(true, "Accept 3-bar cluster displacement", group = ADV, tooltip = "Catches stair-step impulses (common on NQ): 3-bar body sum ≥ 2K × average with net direction.")
float advEqTol    = input.float(0.10, "Equal H/L tolerance ×ATR14 (P3)", minval = 0.02, step = 0.01, group = ADV)
int  advSweepRet  = input.int(3, "Sweep return window, bars (P6)", minval = 1, maxval = 10, group = ADV, tooltip = "Wick beyond the pool must close back within this many bars, else the move is acceptance, not a sweep.")
int  advBuffTicks = input.int(2, "Stop buffer, ticks (P16)", minval = 0, maxval = 20, group = ADV, tooltip = "2 for ES, 4 for NQ.")
bool advFlipOn    = input.bool(true, "Polarity flips (OB→Breaker, FVG→IFVG)", group = ADV, tooltip = "One flip per zone lifetime; a second break retires the zone.")
int  advObLb      = input.int(15, "OB origin scan-back (bars)", minval = 3, maxval = 40, group = ADV)
bool advOteOn     = input.bool(true, "OTE band on armed setup leg (P7)", group = ADV, tooltip = "62-79% retracement of the signal leg, drawn only while a setup is armed.")
int  advArmWin    = input.int(12, "Max bars: sweep → MSS", minval = 4, maxval = 40, group = ADV, tooltip = "Bar-based: M1≈25 · M5≈12 (default) · M15≈6.")
int  advArmExp    = input.int(40, "Armed setup expiry (bars)", minval = 10, maxval = 200, group = ADV, tooltip = "M1≈80 · M5≈40 (default) · M15≈16.")
float advMinRr    = input.float(2.0, "Minimum R:R to arm (P12)", minval = 0.5, step = 0.1, group = ADV, tooltip = "Below this the setup does NOT arm at all (R7/V7 coherence: the system never advertises trades it forbids).")
int  advCorrLen   = input.int(20, "SMT correlation length", minval = 10, maxval = 100, group = ADV)

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 3 · DISPLAY-PRIORITY RESOLUTION (mode → visibility flags, resolved once per run)
// ────────────────────────────────────────────────────────────────────────────────────────────────
bool isFocus    = dispMode == "Focus"
bool isAnalysis = dispMode == "Analysis"
bool ghosts       = isAnalysis                       // retired objects: keep dimmed vs delete
bool showBosInt   = msShowInt and not isFocus
bool showChoch    = msShowInt and isAnalysis
bool showExtAll   = msShowExt and isAnalysis
bool showZoneTxt  = not isFocus
bool showPoolLbl  = not isFocus                      // Focus: labels only on rank ≤ 2 (handled at creation)
bool showOpensFx  = sesOn and not isFocus
bool showBandsFx  = vwOn and vwBands and not isFocus
int  msCap        = isFocus ? math.min(12, perfMsMax) : perfMsMax

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 4 · PRIMITIVES & CLOCK
// ────────────────────────────────────────────────────────────────────────────────────────────────
float atrVal  = ta.atr(14)
float bodyAbs = math.abs(close - open)
float bodyAvg = ta.sma(bodyAbs, 20)
float buffPx  = advBuffTicks * syminfo.mintick
float eqTol   = advEqTol * atrVal
bool  hasVol  = not na(volume)
bool  isLtf   = timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds("60")

float bodySum3 = math.sum(bodyAbs, 3)
bool dispUpEff = (close > open and bodyAbs >= advDispK * bodyAvg) or (advCluster and close > close[3] and bodySum3 >= 2.0 * advDispK * bodyAvg)
bool dispDnEff = (close < open and bodyAbs >= advDispK * bodyAvg) or (advCluster and close < close[3] and bodySum3 >= 2.0 * advDispK * bodyAvg)

bool inAsia  = isLtf and not na(time(timeframe.period, sAsia, NYTZ))
bool inLdn   = isLtf and not na(time(timeframe.period, sLdn, NYTZ))
bool inNyAm  = isLtf and not na(time(timeframe.period, sNyAm, NYTZ))
bool inLunch = isLtf and not na(time(timeframe.period, sLunch, NYTZ))
bool inNyPm  = isLtf and not na(time(timeframe.period, sNyPm, NYTZ))
bool inRth   = isLtf and not na(time(timeframe.period, sRth, NYTZ))
bool inIb    = isLtf and not na(time(timeframe.period, sIb, NYTZ))
bool kzAny   = inLdn or inNyAm or inNyPm

int  nyDom     = dayofmonth(time, NYTZ)
bool newNyDay  = nyDom != nyDom[1]
bool newRth    = inRth and not inRth[1]
bool newGlobex = timeframe.change("D")
bool newWeek   = timeframe.change("W")
bool newMonth  = timeframe.change("M")

var float midnightOpen = na
var float rthOpen      = na
var float weeklyOpen   = na
if newNyDay
    midnightOpen := open
if newRth
    rthOpen := open
if newWeek
    weeklyOpen := open

bool drawWin = last_bar_index - bar_index <= perfDrawLb

// UI throttle: one render at load + one per bar close (kills per-tick dashboard cost)
var bool renderedOnce = false
bool uiTick = barstate.islast and (barstate.isconfirmed or not renderedOnce)

// previous day / week levels + ADR (closed periods ⇒ stable)
float pdHigh = na
float pdLow  = na
float adrVal = na
float pwHigh = na
float pwLow  = na
if liqPdw or regimeOn or sigOn
    [dH, dL, dR] = request.security(syminfo.tickerid, "D", [high[1], low[1], ta.sma(high - low, 14)[1]], lookahead = barmerge.lookahead_off)
    pdHigh := dH
    pdLow  := dL
    adrVal := dR
    [wH, wL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_off)
    pwHigh := wH
    pwLow  := wL

f_sessTrack(bool active) =>
    var float sHi = na
    var float sLo = na
    if active and not active[1]
        sHi := high
        sLo := low
    else if active
        sHi := math.max(sHi, high)
        sLo := math.min(sLo, low)
    bool ended = active[1] and not active
    [sHi, sLo, ended]

[asiaHi, asiaLo, asiaEnd] = f_sessTrack(inAsia)
[ldnHi, ldnLo, ldnEnd]    = f_sessTrack(inLdn)
[ibHi, ibLo, ibEnd]       = f_sessTrack(inIb)

// day-extreme tracker (regime range + RQ-9)
f_winIdx(bool a, bool l, bool n, bool u, bool p) =>
    a ? 0 : l ? 1 : n ? 2 : u ? 3 : p ? 4 : 5

var array<int> hiWinCnt = array.new<int>(6, 0)
var array<int> loWinCnt = array.new<int>(6, 0)
var int dayCnt = 0
var float dHi = na
var float dLo = na
var int dHiW = 5
var int dLoW = 5
int winNow = f_winIdx(inAsia, inLdn, inNyAm, inLunch, inNyPm)
if newNyDay
    if not na(dHi)
        hiWinCnt.set(dHiW, hiWinCnt.get(dHiW) + 1)
        loWinCnt.set(dLoW, loWinCnt.get(dLoW) + 1)
        dayCnt += 1
    dHi := high
    dLo := low
    dHiW := winNow
    dLoW := winNow
else
    if high > nz(dHi, high - syminfo.mintick)
        dHi := high
        dHiW := winNow
    if low < nz(dLo, low + syminfo.mintick)
        dLo := low
        dLoW := winNow
float dayRange = nz(dHi - dLo)

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 5 · TYPES
// ────────────────────────────────────────────────────────────────────────────────────────────────
type StructOut
    bool  bosUp = false
    bool  bosDn = false
    bool  chochUp = false
    bool  chochDn = false
    int   dir = 0
    float hi = na
    int   hiBi = na
    float lo = na
    int   loBi = na
    bool  newPh = false
    bool  newPl = false

type Pool
    float price
    bool  isHigh
    int   rank
    string src
    int   state = 0        // 0 active · 1 penetrated · 2 swept · 3 accepted (transient)
    int   penBi = na
    int   doneBi = na
    float ext = na
    line  ln = na
    label lb = na

type Zone
    box   bx = na
    line  ce = na
    float top
    float bot
    int   kind
    int   dir              // 1 support · -1 resistance
    int   state = 0        // 0 fresh · 1 tested · 2 retired
    int   bornBi
    int   touchBi = na
    bool  inKz = false
    bool  ceTouch = false
    bool  counted = false
    bool  usedB = false
    bool  flipped = false  // one polarity flip per lifetime

type SigVis
    line  entLn = na
    line  stpLn = na
    line  tgtLn = na
    label lbl = na
    box   ote = na

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 6 · SWING & STRUCTURE ENGINE (one implementation, two instances)
// ────────────────────────────────────────────────────────────────────────────────────────────────
f_structure(int len) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    var float lastHi = na
    var int   lastHiBi = na
    var bool  hiBroken = true
    var float lastLo = na
    var int   lastLoBi = na
    var bool  loBroken = true
    var int   trendDir = 0
    StructOut o = StructOut.new()
    if not na(ph)
        lastHi := ph
        lastHiBi := bar_index - len
        hiBroken := false
        o.newPh := true
    if not na(pl)
        lastLo := pl
        lastLoBi := bar_index - len
        loBroken := false
        o.newPl := true
    if barstate.isconfirmed
        if not na(lastHi) and not hiBroken and close > lastHi
            hiBroken := true
            if trendDir < 0
                o.chochUp := true
            else
                o.bosUp := true
            trendDir := 1
        if not na(lastLo) and not loBroken and close < lastLo
            loBroken := true
            if trendDir > 0
                o.chochDn := true
            else
                o.bosDn := true
            trendDir := -1
    o.dir := trendDir
    o.hi := lastHi
    o.hiBi := lastHiBi
    o.lo := lastLo
    o.loBi := lastLoBi
    o

StructOut si = f_structure(msIntLen)
StructOut se = f_structure(msExtLen)

bool mssUpEvt = msOn and si.chochUp and dispUpEff
bool mssDnEvt = msOn and si.chochDn and dispDnEff

var array<line> msLines = array.new<line>()
var array<label> msLabels = array.new<label>()

f_msDraw(int fromBi, float px, string txt, color col) =>
    if drawWin and not na(px) and not na(fromBi)
        msLines.push(line.new(fromBi, px, bar_index, px, xloc = xloc.bar_index, color = col, width = 1, style = line.style_dashed))
        msLabels.push(label.new(bar_index, px, txt, xloc = xloc.bar_index, style = label.style_none, textcolor = col, size = size.tiny))
        while msLines.size() > msCap
            line.delete(msLines.shift())
        while msLabels.size() > msCap
            label.delete(msLabels.shift())

if barstate.isconfirmed and msOn
    if mssUpEvt
        f_msDraw(si.hiBi, si.hi, "MSS ▲", COL_BULL)
    if mssDnEvt
        f_msDraw(si.loBi, si.lo, "MSS ▼", COL_BEAR)
    if showBosInt and si.bosUp
        f_msDraw(si.hiBi, si.hi, "BOS", color.new(COL_BULL, 35))
    if showBosInt and si.bosDn
        f_msDraw(si.loBi, si.lo, "BOS", color.new(COL_BEAR, 35))
    if showChoch and si.chochUp and not dispUpEff
        f_msDraw(si.hiBi, si.hi, "choch", color.new(COL_BULL, 60))
    if showChoch and si.chochDn and not dispDnEff
        f_msDraw(si.loBi, si.lo, "choch", color.new(COL_BEAR, 60))
    if msShowExt and se.chochUp
        f_msDraw(se.hiBi, se.hi, "MSS·ext ▲", color.new(COL_BULL, 0))
    if msShowExt and se.chochDn
        f_msDraw(se.loBi, se.lo, "MSS·ext ▼", color.new(COL_BEAR, 0))
    if showExtAll and se.bosUp
        f_msDraw(se.hiBi, se.hi, "BOS·ext", color.new(COL_BULL, 15))
    if showExtAll and se.bosDn
        f_msDraw(se.loBi, se.lo, "BOS·ext", color.new(COL_BEAR, 15))

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 7 · LIQUIDITY ENGINE (pool map · sweep state machine · consumed liquidity auto-removed)
// ────────────────────────────────────────────────────────────────────────────────────────────────
var array<Pool> pools = array.new<Pool>()

bool sweepUpEvt = false
bool sweepDnEvt = false
bool acceptUpEvt = false
bool acceptDnEvt = false
int  sweepUpCnt = 0
int  sweepDnCnt = 0
int  sweepUpBestRank = 99
int  sweepDnBestRank = 99
float sweepUpExt = na
float sweepDnExt = na

f_poolColor(bool isHigh) =>
    isHigh ? color.new(COL_BEAR, 40) : color.new(COL_BULL, 40)

f_poolDrop(int i) =>
    Pool p = pools.get(i)
    line.delete(p.ln)
    label.delete(p.lb)
    pools.remove(i)

f_poolFreeze(Pool p, color col, bool solid) =>
    if not na(p.ln)
        line.set_extend(p.ln, extend.none)
        line.set_x2(p.ln, bar_index)
        line.set_color(p.ln, col)
        if solid
            line.set_style(p.ln, line.style_solid)
    if not na(p.lb)
        label.set_textcolor(p.lb, color.new(col, 35))

f_addPool(float price, bool isHigh, int rank, string src) =>
    if liqOn and not na(price)
        bool dup = false
        int i = pools.size() - 1
        while i >= 0
            Pool p = pools.get(i)
            if p.src == src and src != "EQH" and src != "EQL"
                f_poolDrop(i)
            else if p.state <= 1 and p.isHigh == isHigh and math.abs(p.price - price) <= eqTol
                dup := true
            i -= 1
        if not dup
            Pool np = Pool.new(price = price, isHigh = isHigh, rank = rank, src = src)
            if liqShow and drawWin
                np.ln := line.new(bar_index, price, bar_index + 1, price, xloc = xloc.bar_index, extend = extend.right, color = f_poolColor(isHigh), width = 1, style = line.style_dotted)
                if showPoolLbl or rank <= 2
                    np.lb := label.new(bar_index + 1, price, src, xloc = xloc.bar_index, style = label.style_none, textcolor = color.new(f_poolColor(isHigh), 20), size = size.tiny)
            pools.push(np)
            while pools.size() > perfPoolMax
                f_poolDrop(0)

// EQH/EQL from consecutive internal pivots (P3)
var float phPrev = na
var float plPrev = na
if liqOn and si.newPh
    if not na(phPrev) and math.abs(si.hi - phPrev) <= eqTol
        f_addPool(math.max(si.hi, phPrev), true, 4, "EQH")
    phPrev := si.hi
if liqOn and si.newPl
    if not na(plPrev) and math.abs(si.lo - plPrev) <= eqTol
        f_addPool(math.min(si.lo, plPrev), false, 4, "EQL")
    plPrev := si.lo

// dated & session pools
if liqOn and barstate.isconfirmed
    if liqPdw and newGlobex and not na(pdHigh)
        f_addPool(pdHigh, true, 2, "PDH")
        f_addPool(pdLow, false, 2, "PDL")
    if liqPdw and newWeek and not na(pwHigh)
        f_addPool(pwHigh, true, 1, "PWH")
        f_addPool(pwLow, false, 1, "PWL")
    if liqSess and asiaEnd
        f_addPool(asiaHi, true, 3, "AS.H")
        f_addPool(asiaLo, false, 3, "AS.L")
    if liqSess and ldnEnd
        f_addPool(ldnHi, true, 3, "LDN.H")
        f_addPool(ldnLo, false, 3, "LDN.L")

// sweep / acceptance state machine (P6) + smart removal
if liqOn and barstate.isconfirmed
    int i = pools.size() - 1
    while i >= 0
        Pool p = pools.get(i)
        if p.state == 2
            // swept: keep through the decision window, then remove (ghost in Analysis)
            if not ghosts and bar_index - nz(p.doneBi, bar_index) > perfSweptTtl
                f_poolDrop(i)
        else if p.state <= 1
            if p.isHigh
                if close > p.price
                    acceptUpEvt := true
                    f_poolDrop(i)   // accepted = no longer liquidity
                else if high > p.price
                    if p.state == 0
                        p.state := 1
                        p.penBi := bar_index
                    p.ext := math.max(nz(p.ext, high), high)
                else if p.state == 1
                    if bar_index - p.penBi <= advSweepRet
                        p.state := 2
                        p.doneBi := bar_index
                        sweepUpEvt := true
                        sweepUpCnt += 1
                        sweepUpBestRank := math.min(sweepUpBestRank, p.rank)
                        sweepUpExt := math.max(nz(sweepUpExt, p.ext), p.ext)
                        f_poolFreeze(p, f_poolColor(true), true)
                    else
                        p.state := 2
                        p.doneBi := bar_index
                        f_poolFreeze(p, color.new(COL_DIM, 70), false)
            else
                if close < p.price
                    acceptDnEvt := true
                    f_poolDrop(i)
                else if low < p.price
                    if p.state == 0
                        p.state := 1
                        p.penBi := bar_index
                    p.ext := math.min(nz(p.ext, low), low)
                else if p.state == 1
                    if bar_index - p.penBi <= advSweepRet
                        p.state := 2
                        p.doneBi := bar_index
                        sweepDnEvt := true
                        sweepDnCnt += 1
                        sweepDnBestRank := math.min(sweepDnBestRank, p.rank)
                        sweepDnExt := math.min(nz(sweepDnExt, p.ext), p.ext)
                        f_poolFreeze(p, f_poolColor(false), true)
                    else
                        p.state := 2
                        p.doneBi := bar_index
                        f_poolFreeze(p, color.new(COL_DIM, 70), false)
        i -= 1

// sweep memory for the signal engine
var int   lastSwpUpBi = na
var int   lastSwpDnBi = na
var float lastSwpUpExt = na
var float lastSwpDnExt = na
var int   lastSwpUpRank = 99
var int   lastSwpDnRank = 99
var int   lastSwpUpCnt = 0
var int   lastSwpDnCnt = 0
if sweepUpEvt
    lastSwpUpBi := bar_index
    lastSwpUpExt := sweepUpExt
    lastSwpUpRank := sweepUpBestRank
    lastSwpUpCnt := sweepUpCnt
if sweepDnEvt
    lastSwpDnBi := bar_index
    lastSwpDnExt := sweepDnExt
    lastSwpDnRank := sweepDnBestRank
    lastSwpDnCnt := sweepDnCnt

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 8 · ZONE ENGINE (FVG/IFVG · OB/Breaker/Mitigation · one flip per lifetime · dead zones removed)
// ────────────────────────────────────────────────────────────────────────────────────────────────
var array<Zone> fvgZones = array.new<Zone>()
var array<Zone> obZones = array.new<Zone>()

f_stInc(int slot) =>
    stArr.set(slot, stArr.get(slot) + 1)

f_zoneBg(int kind, int zdir) =>
    kind == Z_MIT ? ZBG_MIT : kind == Z_BRK ? ZBG_BRK : kind == Z_IFV ? ZBG_IFV : zdir > 0 ? ZBG_BULL : ZBG_BEAR

f_zoneBr(int kind, int zdir) =>
    kind == Z_MIT ? ZBR_MIT : kind == Z_BRK ? ZBR_BRK : kind == Z_IFV ? ZBR_IFV : zdir > 0 ? ZBR_BULL : ZBR_BEAR

f_zoneTxt(int kind) =>
    kind == Z_FVG ? "FVG" : kind == Z_OB ? "OB" : kind == Z_MIT ? "MIT" : kind == Z_BRK ? "BRK" : "iFVG"

f_zoneNew(array<Zone> arr, int leftBi, float top, float bot, int kind, int zdir, int capN) =>
    Zone z = Zone.new(top = top, bot = bot, kind = kind, dir = zdir, bornBi = bar_index, inKz = kzAny)
    if drawWin
        z.bx := box.new(leftBi, top, bar_index + 1, bot, border_color = f_zoneBr(kind, zdir), border_width = 1, bgcolor = f_zoneBg(kind, zdir), extend = extend.right, text = showZoneTxt ? f_zoneTxt(kind) : "", text_size = size.tiny, text_color = color.new(f_zoneBr(kind, zdir), 30), text_halign = text.align_right, text_valign = text.align_center)
        if kind == Z_FVG and fvgShowCe
            z.ce := line.new(leftBi, (top + bot) / 2, bar_index + 1, (top + bot) / 2, xloc = xloc.bar_index, extend = extend.right, color = color.new(f_zoneBr(kind, zdir), 45), width = 1, style = line.style_dotted)
    arr.push(z)
    while arr.size() > capN
        Zone old = arr.shift()
        box.delete(old.bx)
        line.delete(old.ce)
    z

f_zoneFlip(Zone z, int newKind) =>
    z.kind := newKind
    z.dir := -z.dir
    z.state := 0
    z.ceTouch := false
    z.counted := false
    z.touchBi := na
    z.bornBi := bar_index
    z.flipped := true
    if not na(z.bx)
        box.set_bgcolor(z.bx, f_zoneBg(newKind, z.dir))
        box.set_border_color(z.bx, f_zoneBr(newKind, z.dir))
        box.set_text(z.bx, showZoneTxt ? f_zoneTxt(newKind) : "")
    if not na(z.ce)
        line.set_color(z.ce, color.new(COL_DIM, 85))

// retire = freeze as ghost (Analysis) or delete outright (Focus/Standard).
// state := 2 is set in BOTH paths: later checks on a held reference must see the zone dead
// (prevents double-remove on the same index within one lifecycle pass).
f_zoneRetire(array<Zone> arr, int i) =>
    Zone z = arr.get(i)
    z.state := 2
    if ghosts
        if not na(z.bx)
            box.set_extend(z.bx, extend.none)
            box.set_right(z.bx, bar_index)
            box.set_bgcolor(z.bx, GHOST_BG)
            box.set_border_color(z.bx, GHOST_BR)
        if not na(z.ce)
            line.set_extend(z.ce, extend.none)
            line.set_x2(z.ce, bar_index)
            line.set_color(z.ce, GHOST_BR)
    else
        box.delete(z.bx)
        line.delete(z.ce)
        arr.remove(i)

// creation — FVG (3-candle inequality, P5)
bool fvgBullNew = false
bool fvgBearNew = false
if fvgOn and barstate.isconfirmed
    if low > high[2] and (low - high[2]) >= fvgMinAtr * atrVal
        Zone zNew = f_zoneNew(fvgZones, bar_index - 2, low, high[2], Z_FVG, 1, perfFvgMax)
        fvgBullNew := true
        if zNew.inKz
            f_stInc(ST_FVG_TOT)
    if high < low[2] and (low[2] - high) >= fvgMinAtr * atrVal
        Zone zNew = f_zoneNew(fvgZones, bar_index - 2, low[2], high, Z_FVG, -1, perfFvgMax)
        fvgBearNew := true
        if zNew.inKz
            f_stInc(ST_FVG_TOT)

// creation — OB / Mitigation on qualified breaks
f_obOverlap(float top, float bot, int zdir) =>
    bool ov = false
    for [idx, z] in obZones
        if z.state < 2 and z.dir == zdir and not (bot > z.top or top < z.bot)
            ov := true
    ov

f_obScan(bool wantDown) =>
    int found = -1
    for i = 1 to advObLb
        if (wantDown and close[i] < open[i]) or (not wantDown and close[i] > open[i])
            found := i
            break
    found

if obOn and barstate.isconfirmed and (mssUpEvt or (obOnBos and si.bosUp))
    int fnd = f_obScan(true)
    if fnd > 0
        float zTop = open[fnd]
        float zBot = obBodyOnly ? close[fnd] : low[fnd]
        if zTop > zBot and not f_obOverlap(zTop, zBot, 1)
            bool hasSwp = not na(lastSwpDnBi) and bar_index - lastSwpDnBi <= fnd + 5
            Zone zNew = f_zoneNew(obZones, bar_index - fnd, zTop, zBot, hasSwp ? Z_OB : Z_MIT, 1, perfObMax)
            f_stInc(ST_OB_TOT)
if obOn and barstate.isconfirmed and (mssDnEvt or (obOnBos and si.bosDn))
    int fnd = f_obScan(false)
    if fnd > 0
        float zTop = obBodyOnly ? close[fnd] : high[fnd]
        float zBot = open[fnd]
        if zTop > zBot and not f_obOverlap(zTop, zBot, -1)
            bool hasSwp = not na(lastSwpUpBi) and bar_index - lastSwpUpBi <= fnd + 5
            Zone zNew = f_zoneNew(obZones, bar_index - fnd, zTop, zBot, hasSwp ? Z_OB : Z_MIT, -1, perfObMax)
            f_stInc(ST_OB_TOT)

// lifecycle — touch / CE / fill / single flip / stale expiry; returns [touchBull, touchBear]
f_zoneLifecycle(array<Zone> arr, bool isFvg) =>
    bool tBull = false
    bool tBear = false
    if barstate.isconfirmed
        int i = arr.size() - 1
        while i >= 0
            Zone z = arr.get(i)
            if z.state < 2
                float mid = (z.top + z.bot) / 2
                bool brokeFar = z.dir > 0 ? close < z.bot : close > z.top
                if brokeFar
                    if isFvg and z.kind == Z_FVG and z.inKz
                        f_stInc(ST_FVG_FILL)
                        f_stInc(ST_FVG_INV)
                    if advFlipOn and not z.flipped
                        f_zoneFlip(z, isFvg ? Z_IFV : Z_BRK)
                    else
                        f_zoneRetire(arr, i)
                else
                    bool touched = z.dir > 0 ? low <= z.top : high >= z.bot
                    if touched
                        if z.state == 0
                            z.state := 1
                            z.touchBi := bar_index
                            if z.dir > 0
                                tBull := true
                            else
                                tBear := true
                            if not isFvg
                                f_stInc(ST_OB_TOUCH)
                        if isFvg and z.kind == Z_FVG and not z.ceTouch and (z.dir > 0 ? low <= mid : high >= mid)
                            z.ceTouch := true
                            z.touchBi := bar_index
                            if z.inKz
                                f_stInc(ST_FVG_CE)
                        bool filled = isFvg and z.kind == Z_FVG and (z.dir > 0 ? low <= z.bot : high >= z.top)
                        if filled
                            if z.inKz
                                f_stInc(ST_FVG_FILL)
                            f_zoneRetire(arr, i)
                    // reaction statistic (RQ-6/7): ≥ 1 zone-height beyond far edge within 10 bars
                    if z.state == 1 and not z.counted and not na(z.touchBi)
                        float zh = z.top - z.bot
                        bool reacted = z.dir > 0 ? high >= z.top + zh : low <= z.bot - zh
                        if reacted
                            z.counted := true
                            if isFvg and z.inKz
                                f_stInc(ST_FVG_ROK)
                                f_stInc(ST_FVG_RTOT)
                            if not isFvg
                                f_stInc(ST_OB_ROK)
                        else if bar_index - z.touchBi > 10
                            z.counted := true
                            if isFvg and z.inKz
                                f_stInc(ST_FVG_RTOT)
                    if z.state < 2 and bar_index - z.bornBi > perfZoneAge
                        f_zoneRetire(arr, i)
            i -= 1
    [tBull, tBear]

[fvgTb, fvgTr] = f_zoneLifecycle(fvgZones, true)
[obTb, obTr] = f_zoneLifecycle(obZones, false)

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 9 · RANGE ENGINE (dealing range · EQ · premium/discount)
// ────────────────────────────────────────────────────────────────────────────────────────────────
float extHi = se.hi
float extLo = se.lo
float rngEq = (extHi + extLo) / 2
float pdPct = not na(extHi) and not na(extLo) and extHi > extLo ? (close - extLo) / (extHi - extLo) * 100 : na
string pdZone = na(pdPct) ? "—" : pdPct > 55 ? "PREMIUM" : pdPct < 45 ? "DISCOUNT" : "EQ"

var line eqLn = na
var label eqLb = na
if pdOn and uiTick and not na(rngEq)
    int x1 = math.max(nz(se.hiBi, bar_index - 50), nz(se.loBi, bar_index - 50))
    if na(eqLn)
        eqLn := line.new(x1, rngEq, bar_index + 10, rngEq, xloc = xloc.bar_index, color = color.new(COL_EQ, 35), width = 1, style = line.style_dashed)
        eqLb := label.new(bar_index + 10, rngEq, "EQ", xloc = xloc.bar_index, style = label.style_none, textcolor = color.new(COL_EQ, 25), size = size.tiny)
    else
        line.set_xy1(eqLn, x1, rngEq)
        line.set_xy2(eqLn, bar_index + 10, rngEq)
        label.set_xy(eqLb, bar_index + 10, rngEq)

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 10 · VWAP ENGINE (session VWAP + vw-σ bands · RTH VWAP · AVWAPs)
// ────────────────────────────────────────────────────────────────────────────────────────────────
float srcV = hlc3
var float sPV = na
var float sV = na
var float sPV2 = na
if vwOn and hasVol
    if newGlobex or na(sPV)
        sPV := srcV * volume
        sV := volume
        sPV2 := srcV * srcV * volume
    else
        sPV += srcV * volume
        sV += volume
        sPV2 += srcV * srcV * volume
float sesVwap = vwOn and hasVol and nz(sV) > 0 ? sPV / sV : na
float sesSd = na
if not na(sesVwap)
    sesSd := math.sqrt(math.max(sPV2 / sV - sesVwap * sesVwap, 0))
float sigmaPos = not na(sesVwap) and nz(sesSd) > 0 ? (close - sesVwap) / sesSd : na

var float rPV = na
var float rV = na
if vwRthOn and hasVol
    if newRth or na(rPV)
        rPV := srcV * volume
        rV := volume
    else if inRth
        rPV += srcV * volume
        rV += volume
float rthVwap = vwRthOn and hasVol and inRth and nz(rV) > 0 ? rPV / rV : na

f_avwap(bool resetCond, bool active) =>
    var float aPV = na
    var float aV = na
    if active and hasVol
        if resetCond or na(aPV)
            aPV := srcV * volume
            aV := volume
        else
            aPV += srcV * volume
            aV += volume
    active and nz(aV) > 0 ? aPV / aV : float(na)

bool customAnchorHit = time >= avCT and time[1] < avCT
float avwapW = f_avwap(newWeek, avWOn)
float avwapM = f_avwap(newMonth, avMOn)
float avwapS = f_avwap(se.chochUp or se.chochDn, avSOn)
float avwapC = f_avwap(customAnchorHit, avCOn)

bool vwapXUp = ta.crossover(close, sesVwap)
bool vwapXDn = ta.crossunder(close, sesVwap)
var int lastVwapXUpBi = na
var int lastVwapXDnBi = na
if vwapXUp
    lastVwapXUpBi := bar_index
if vwapXDn
    lastVwapXDnBi := bar_index

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 11 · SMT ENGINE (confirmed-pivot divergence · returns-correlation regime gate)
// ────────────────────────────────────────────────────────────────────────────────────────────────
float corrPh = na
float corrPl = na
float corrCl = na
if smtOn
    [q1, q2, q3] = request.security(smtSym, timeframe.period, [ta.pivothigh(high, msIntLen, msIntLen), ta.pivotlow(low, msIntLen, msIntLen), close], lookahead = barmerge.lookahead_off)
    corrPh := q1
    corrPl := q2
    corrCl := q3
// returns correlation — price-level correlation is spuriously ~1 for any two trending series
float corrVal = ta.correlation(ta.change(close), ta.change(corrCl), advCorrLen)
bool corrOk = smtOn and not na(corrVal) and corrVal >= corrMin

var float ownPh1 = na
var float ownPh2 = na
var int   ownPh1Bi = na
var int   ownPh2Bi = na
var float ownPl1 = na
var float ownPl2 = na
var int   ownPl1Bi = na
var int   ownPl2Bi = na
var float cPh1 = na
var float cPh2 = na
var int   cPh1Bi = na
var float cPl1 = na
var float cPl2 = na
var int   cPl1Bi = na

if smtOn and not na(corrPh)
    cPh2 := cPh1
    cPh1 := corrPh
    cPh1Bi := bar_index - msIntLen
if smtOn and not na(corrPl)
    cPl2 := cPl1
    cPl1 := corrPl
    cPl1Bi := bar_index - msIntLen

f_nearPool(float px) =>
    bool nearP = not smtAtPools
    if smtAtPools
        for [idx, p] in pools
            if p.state <= 2 and math.abs(p.price - px) <= 0.5 * atrVal
                nearP := true
    nearP

var array<line> smtLines = array.new<line>()
var array<label> smtLabels = array.new<label>()

f_smtDraw(int x1, float y1, int x2, float y2, string txt, color col) =>
    if drawWin
        smtLines.push(line.new(x1, y1, x2, y2, xloc = xloc.bar_index, color = col, width = 2))
        smtLabels.push(label.new(x2, y2, txt, xloc = xloc.bar_index, style = y1 > y2 ? label.style_label_up : label.style_label_down, color = color.new(col, 25), textcolor = color.white, size = size.tiny))
        while smtLines.size() > perfSmtMax
            line.delete(smtLines.shift())
        while smtLabels.size() > perfSmtMax
            label.delete(smtLabels.shift())

bool smtBearEvt = false
bool smtBullEvt = false
if smtOn and si.newPh
    if not na(ownPh1)
        ownPh2 := ownPh1
        ownPh2Bi := ownPh1Bi
    ownPh1 := si.hi
    ownPh1Bi := si.hiBi
    if corrOk and not na(ownPh2) and not na(cPh2) and not na(cPh1Bi) and math.abs(ownPh1Bi - cPh1Bi) <= 5
        if ownPh1 > ownPh2 and cPh1 < cPh2 and f_nearPool(ownPh1)
            smtBearEvt := true
            f_smtDraw(ownPh2Bi, ownPh2, ownPh1Bi, ownPh1, "SMT ▼", COL_BEAR)
if smtOn and si.newPl
    if not na(ownPl1)
        ownPl2 := ownPl1
        ownPl2Bi := ownPl1Bi
    ownPl1 := si.lo
    ownPl1Bi := si.loBi
    if corrOk and not na(ownPl2) and not na(cPl2) and not na(cPl1Bi) and math.abs(ownPl1Bi - cPl1Bi) <= 5
        if ownPl1 < ownPl2 and cPl1 > cPl2 and f_nearPool(ownPl1)
            smtBullEvt := true
            f_smtDraw(ownPl2Bi, ownPl2, ownPl1Bi, ownPl1, "SMT ▲", COL_BULL)

var int lastSmtBullBi = na
var int lastSmtBearBi = na
if smtBullEvt
    lastSmtBullBi := bar_index
if smtBearEvt
    lastSmtBearBi := bar_index

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 12 · HTF BIAS & DAY REGIME
// ────────────────────────────────────────────────────────────────────────────────────────────────
float bPh = na
float bPl = na
float bCl = na
if biasOn
    [w1, w2, w3] = request.security(syminfo.tickerid, biasTf, [ta.pivothigh(high, 8, 8), ta.pivotlow(low, 8, 8), close], lookahead = barmerge.lookahead_off)
    bPh := w1
    bPl := w2
    bCl := w3

var float htfHi = na
var float htfLo = na
var bool  htfHiBrk = true
var bool  htfLoBrk = true
var int   biasDir = 0
if biasOn
    if not na(bPh)
        htfHi := bPh
        htfHiBrk := false
    if not na(bPl)
        htfLo := bPl
        htfLoBrk := false
    if barstate.isconfirmed and not na(bCl)
        if not na(htfHi) and not htfHiBrk and bCl > htfHi
            htfHiBrk := true
            biasDir := 1
        if not na(htfLo) and not htfLoBrk and bCl < htfLo
            htfLoBrk := true
            biasDir := -1

var int gapVote = 0
var int ibVote = 0
var int acceptVote = 0
var int vwapSideCnt = 0
var int rthBarCnt = 0
if newRth
    gapVote := 0
    ibVote := 0
    acceptVote := 0
    vwapSideCnt := 0
    rthBarCnt := 0
    if not na(pdHigh)
        gapVote := open > pdHigh ? 1 : open < pdLow ? -1 : 0
if regimeOn and inRth and barstate.isconfirmed
    rthBarCnt += 1
    vwapSideCnt += not na(sesVwap) ? (close > sesVwap ? 1 : -1) : 0
    if not inIb and ibVote == 0 and not na(ibHi)
        if close > ibHi and dispUpEff
            ibVote := 1
        else if close < ibLo and dispDnEff
            ibVote := -1
    if acceptUpEvt
        acceptVote := 1
    if acceptDnEvt
        acceptVote := -1

float chEvt = si.chochUp or si.chochDn ? 1.0 : 0.0
float intChanges20 = math.sum(chEvt, 20)

int regime = 0
if regimeOn
    float vwapFrac = rthBarCnt > 10 ? 1.0 * vwapSideCnt / rthBarCnt : 0.0
    int score = gapVote + ibVote + acceptVote + (vwapFrac > 0.8 ? 1 : vwapFrac < -0.8 ? -1 : 0)
    if score >= 2
        regime := 1
    else if score <= -2
        regime := -1
    else if intChanges20 >= 4 and not na(adrVal) and dayRange < 0.5 * adrVal and not inIb and rthBarCnt > 30
        regime := 2
string regimeTxt = regime == 1 ? "TREND ▲" : regime == -1 ? "TREND ▼" : regime == 2 ? "CHOP" : "ROTATION"

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 13 · SIGNAL ENGINE (factored: one implementation per setup, both directions)
// ────────────────────────────────────────────────────────────────────────────────────────────────
bool kzSigOk = inLdn or inNyAm

f_nearestPoolAbove(float px) =>
    float best = na
    for [idx, p] in pools
        if p.state <= 1 and p.isHigh and p.price > px
            best := na(best) ? p.price : math.min(best, p.price)
    best

f_nearestPoolBelow(float px) =>
    float best = na
    for [idx, p] in pools
        if p.state <= 1 and not p.isHigh and p.price < px
            best := na(best) ? p.price : math.max(best, p.price)
    best

f_lastFvgSince(int sinceBi, int zdir) =>
    Zone found = na
    int i = fvgZones.size() - 1
    while i >= 0 and na(found)
        Zone z = fvgZones.get(i)
        if z.kind == Z_FVG and z.dir == zdir and z.state < 2 and z.bornBi >= sinceBi
            found := z
        i -= 1
    found

f_fvgInsideOb(Zone z) =>
    bool comp = false
    if not na(z)
        for [idx, ob] in obZones
            if ob.state < 2 and ob.dir == z.dir and z.top <= ob.top + eqTol and z.bot >= ob.bot - eqTol
                comp := true
    comp

// Setup A evaluation for one direction; reads engine state, returns geometry + grade points
f_setupA(int dir) =>
    bool ok = false
    float entry = na
    float stp = na
    float tgt = na
    float rr = na
    float pts = 0.0
    int   swpBi   = dir > 0 ? lastSwpDnBi : lastSwpUpBi
    float swpExt  = dir > 0 ? lastSwpDnExt : lastSwpUpExt
    int   swpRank = dir > 0 ? lastSwpDnRank : lastSwpUpRank
    int   swpCnt  = dir > 0 ? lastSwpDnCnt : lastSwpUpCnt
    if not na(swpBi) and bar_index - swpBi <= advArmWin
        Zone z = f_lastFvgSince(swpBi, dir)
        if not na(z)
            float mid = (z.top + z.bot) / 2
            bool pdOk = not pdOn or na(rngEq) or (dir > 0 ? mid <= rngEq : mid >= rngEq)
            if pdOk
                float s = dir > 0 ? swpExt - buffPx : swpExt + buffPx
                float rawT = dir > 0 ? f_nearestPoolAbove(close) : f_nearestPoolBelow(close)
                float t = na(rawT) ? (dir > 0 ? extHi : extLo) : rawT
                bool geomOk = dir > 0 ? mid > s and not na(t) and t > mid : s > mid and not na(t) and t < mid
                if geomOk
                    float r = dir > 0 ? (t - mid) / (mid - s) : (mid - t) / (s - mid)
                    if r >= advMinRr
                        int smtBi = dir > 0 ? lastSmtBullBi : lastSmtBearBi
                        int vwXBi = dir > 0 ? lastVwapXUpBi : lastVwapXDnBi
                        pts += not na(smtBi) and bar_index - smtBi <= advArmWin ? 1.0 : 0.0
                        pts += swpCnt >= 2 ? 1.0 : 0.0
                        pts += swpRank <= 2 ? 1.0 : 0.0
                        pts += not na(vwXBi) and bar_index - vwXBi <= 3 ? 0.5 : 0.0
                        pts += f_fvgInsideOb(z) ? 0.5 : 0.0
                        ok := true
                        entry := mid
                        stp := s
                        tgt := t
                        rr := r
    [ok, entry, stp, tgt, rr, pts]

// Setup B: pullback into an unspent flip-quality zone (BRK / OB / IFVG) with the trend regime
f_bScan(array<Zone> arr, int dir, int coolBi) =>
    bool found = false
    float stp = na
    float rr = na
    string ztxt = ""
    Zone hit = na
    for [idx, z] in arr
        bool kindOk = z.kind == Z_BRK or z.kind == Z_OB or z.kind == Z_IFV
        if not found and z.state < 2 and z.dir == dir and kindOk and not z.usedB
            bool trig = dir > 0 ? low <= z.top and close > z.top : high >= z.bot and close < z.bot
            if trig and (na(coolBi) or bar_index - coolBi > 10)
                float s = dir > 0 ? z.bot - buffPx : z.top + buffPx
                float rawT = dir > 0 ? f_nearestPoolAbove(close) : f_nearestPoolBelow(close)
                float t = na(rawT) ? (dir > 0 ? extHi : extLo) : rawT
                bool geomOk = dir > 0 ? close > s and not na(t) and t > close : s > close and not na(t) and t < close
                if geomOk
                    float r = dir > 0 ? (t - close) / (close - s) : (close - t) / (s - close)
                    if r >= 1.0
                        found := true
                        hit := z
                        stp := s
                        rr := r
                        ztxt := f_zoneTxt(z.kind)
    [found, stp, rr, ztxt, hit]

f_grade(float pts) =>
    pts >= 2.5 ? "A+" : pts >= 1.0 ? "A" : "B"

f_px(float x) =>
    str.tostring(x, format.mintick)

// armed-setup visuals
var int    aState = 0
var int    aDir = 0
var int    aArmBi = na
var float  aEntry = na
var float  aStop = na
var string aGrade = ""
var SigVis aVis = SigVis.new()

f_aClear(SigVis v) =>
    line.delete(v.entLn)
    line.delete(v.stpLn)
    line.delete(v.tgtLn)
    label.delete(v.lbl)
    box.delete(v.ote)
    v.entLn := na
    v.stpLn := na
    v.tgtLn := na
    v.lbl := na
    v.ote := na

f_aDraw(SigVis v, int dir, float entry, float stp, float tgt, string txt, color col, float legLo, float legHi) =>
    f_aClear(v)
    if drawWin
        v.entLn := line.new(bar_index, entry, bar_index + 12, entry, xloc = xloc.bar_index, color = col, width = 2)
        v.stpLn := line.new(bar_index, stp, bar_index + 12, stp, xloc = xloc.bar_index, color = COL_BEAR, width = 1, style = line.style_dashed)
        v.tgtLn := line.new(bar_index, tgt, bar_index + 12, tgt, xloc = xloc.bar_index, color = COL_BULL, width = 1, style = line.style_dashed)
        v.lbl := label.new(bar_index + 12, entry, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(col, 20), textcolor = color.white, size = size.small)
        if advOteOn and legHi > legLo
            float rng = legHi - legLo
            float o1 = dir > 0 ? legHi - 0.62 * rng : legLo + 0.62 * rng
            float o2 = dir > 0 ? legHi - 0.79 * rng : legLo + 0.79 * rng
            v.ote := box.new(bar_index, math.max(o1, o2), bar_index + 12, math.min(o1, o2), border_color = color.new(col, 70), border_width = 1, bgcolor = color.new(col, 92), text = "OTE", text_size = size.tiny, text_color = color.new(col, 45))

bool setupALong = false
bool setupAShort = false
string aAlertTxt = ""

if sigOn and barstate.isconfirmed
    // armed-state maintenance
    if aState == 1
        bool expired = bar_index - aArmBi > advArmExp
        bool invalid = aDir > 0 ? close < aStop : close > aStop
        bool filled = aDir > 0 ? low <= aEntry : high >= aEntry
        if invalid or expired
            aState := 0
            f_aClear(aVis)
        else if filled
            aState := 2
            if not na(aVis.lbl)
                label.set_text(aVis.lbl, "A " + (aDir > 0 ? "LONG" : "SHORT") + " · " + aGrade + " · FILLED")
    else if aState == 2 and bar_index - aArmBi > advArmExp
        aState := 0
        f_aClear(aVis)
    // new arms (a new qualified signal replaces the previous one)
    if kzSigOk and regime != -1 and mssUpEvt
        [ok, e, s, t, r, pts] = f_setupA(1)
        if ok
            aState := 1
            aDir := 1
            aArmBi := bar_index
            aEntry := e
            aStop := s
            aGrade := f_grade(pts)
            setupALong := true
            f_aDraw(aVis, 1, e, s, t, "SETUP A LONG · " + aGrade + " · RR " + str.tostring(r, "#.##"), COL_BULL, lastSwpDnExt, high)
            aAlertTxt := "IFTS Setup A LONG [" + aGrade + "] " + syminfo.ticker + " · entry " + f_px(e) + " · stop " + f_px(s) + " · target " + f_px(t) + " · RR " + str.tostring(r, "#.##")
    if not setupALong and kzSigOk and regime != 1 and mssDnEvt
        [ok, e, s, t, r, pts] = f_setupA(-1)
        if ok
            aState := 1
            aDir := -1
            aArmBi := bar_index
            aEntry := e
            aStop := s
            aGrade := f_grade(pts)
            setupAShort := true
            f_aDraw(aVis, -1, e, s, t, "SETUP A SHORT · " + aGrade + " · RR " + str.tostring(r, "#.##"), COL_BEAR, low, lastSwpUpExt)
            aAlertTxt := "IFTS Setup A SHORT [" + aGrade + "] " + syminfo.ticker + " · entry " + f_px(e) + " · stop " + f_px(s) + " · target " + f_px(t) + " · RR " + str.tostring(r, "#.##")

bool setupBLong = false
bool setupBShort = false
string bAlertTxt = ""
var int lastBLongBi = na
var int lastBShortBi = na
bool bTimeOk = inRth and not inLunch and not inIb

if sigOn and barstate.isconfirmed and bTimeOk
    if regime == 1 and (not biasOn or biasDir >= 0)
        [f1, s1, r1, zt1, h1] = f_bScan(obZones, 1, lastBLongBi)
        if f1
            setupBLong := true
            h1.usedB := true
            lastBLongBi := bar_index
            bAlertTxt := "IFTS Setup B LONG " + syminfo.ticker + " · " + zt1 + " zone · stop " + f_px(s1) + " · RR " + str.tostring(r1, "#.##")
        else
            [f2, s2, r2, zt2, h2] = f_bScan(fvgZones, 1, lastBLongBi)
            if f2
                setupBLong := true
                h2.usedB := true
                lastBLongBi := bar_index
                bAlertTxt := "IFTS Setup B LONG " + syminfo.ticker + " · " + zt2 + " zone · stop " + f_px(s2) + " · RR " + str.tostring(r2, "#.##")
    if regime == -1 and (not biasOn or biasDir <= 0)
        [f3, s3, r3, zt3, h3] = f_bScan(obZones, -1, lastBShortBi)
        if f3
            setupBShort := true
            h3.usedB := true
            lastBShortBi := bar_index
            bAlertTxt := "IFTS Setup B SHORT " + syminfo.ticker + " · " + zt3 + " zone · stop " + f_px(s3) + " · RR " + str.tostring(r3, "#.##")
        else
            [f4, s4, r4, zt4, h4] = f_bScan(fvgZones, -1, lastBShortBi)
            if f4
                setupBShort := true
                h4.usedB := true
                lastBShortBi := bar_index
                bAlertTxt := "IFTS Setup B SHORT " + syminfo.ticker + " · " + zt4 + " zone · stop " + f_px(s4) + " · RR " + str.tostring(r4, "#.##")

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 14 · STATISTICS (RQ-2 sweep→MSS; RQ-7 in zone engine; RQ-9 in day tracker)
// ────────────────────────────────────────────────────────────────────────────────────────────────
var int swpTotUp = 0
var int swpMssUp = 0
var int swpTotDn = 0
var int swpMssDn = 0
var int pendSwpUpBi = na
var int pendSwpDnBi = na
if barstate.isconfirmed
    if not na(pendSwpDnBi)
        if mssUpEvt and bar_index - pendSwpDnBi <= advArmWin
            swpTotDn += 1
            swpMssDn += 1
            pendSwpDnBi := na
        else if bar_index - pendSwpDnBi > advArmWin
            swpTotDn += 1
            pendSwpDnBi := na
    if not na(pendSwpUpBi)
        if mssDnEvt and bar_index - pendSwpUpBi <= advArmWin
            swpTotUp += 1
            swpMssUp += 1
            pendSwpUpBi := na
        else if bar_index - pendSwpUpBi > advArmWin
            swpTotUp += 1
            pendSwpUpBi := na
    if sweepDnEvt
        pendSwpDnBi := bar_index
    if sweepUpEvt
        pendSwpUpBi := bar_index

f_pct(int num, int den) =>
    den > 0 ? str.tostring(100.0 * num / den, "#") + "%" : "—"

f_winName(int wi) =>
    wi == 0 ? "Asia" : wi == 1 ? "London" : wi == 2 ? "NY AM" : wi == 3 ? "Lunch" : wi == 4 ? "NY PM" : "Other"

f_winArgmax(array<int> a) =>
    int best = 0
    int bi = 5
    for [idx, v] in a
        if v > best
            best := v
            bi := idx
    [bi, best]

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 15 · DASHBOARD (static keys written once · values refresh on bar close only)
// ────────────────────────────────────────────────────────────────────────────────────────────────
string tszDash = dashSz == "Tiny" ? size.tiny : dashSz == "Small" ? size.small : size.normal

// one cell writer (Pine does not allow nested functions — global, single responsibility)
f_dashCell(table t, bool keysPass, int row, string txt, color tc) =>
    table.cell(t, keysPass ? 0 : 1, row, txt, text_color = tc, text_size = tszDash, text_halign = keysPass ? text.align_left : text.align_right)

// fills one column: keysPass=true → static key column (once), false → value column (per bar close)
f_dashFill(table t, bool keysPass) =>
    int r = 0
    f_dashCell(t, keysPass, r, keysPass ? "IFTS 2.0" : syminfo.ticker + " · " + timeframe.period, COL_TXT)
    r += 1
    if biasOn
        f_dashCell(t, keysPass, r, keysPass ? "Bias " + biasTf : biasDir == 1 ? "LONG" : biasDir == -1 ? "SHORT" : "—", keysPass ? COL_DIM : biasDir == 1 ? COL_BULL : biasDir == -1 ? COL_BEAR : COL_DIM)
        r += 1
    if regimeOn
        f_dashCell(t, keysPass, r, keysPass ? "Regime" : regimeTxt, keysPass ? COL_DIM : regime == 1 ? COL_BULL : regime == -1 ? COL_BEAR : regime == 2 ? COL_BRK : COL_TXT)
        r += 1
    f_dashCell(t, keysPass, r, keysPass ? "Session" : inNyAm ? "NY AM KZ" : inLdn ? "LONDON KZ" : inNyPm ? "NY PM KZ" : inLunch ? "LUNCH ✗" : inAsia ? "ASIA" : inRth ? "RTH" : "OFF", keysPass ? COL_DIM : kzAny ? COL_BULL : COL_DIM)
    r += 1
    if liqOn
        string swV = not na(lastSwpDnBi) and bar_index - lastSwpDnBi <= 30 ? "SSL r" + str.tostring(lastSwpDnRank) + " · " + str.tostring(bar_index - lastSwpDnBi) + "b" : not na(lastSwpUpBi) and bar_index - lastSwpUpBi <= 30 ? "BSL r" + str.tostring(lastSwpUpRank) + " · " + str.tostring(bar_index - lastSwpUpBi) + "b" : "—"
        f_dashCell(t, keysPass, r, keysPass ? "Last sweep" : swV, keysPass ? COL_DIM : COL_POOL)
        r += 1
    if sigOn
        f_dashCell(t, keysPass, r, keysPass ? "Setup A" : aState == 1 ? "ARMED " + (aDir > 0 ? "LONG " : "SHORT ") + aGrade : aState == 2 ? "FILLED " + aGrade : "idle", keysPass ? COL_DIM : aState > 0 ? (aDir > 0 ? COL_BULL : COL_BEAR) : COL_DIM)
        r += 1
    f_dashCell(t, keysPass, r, keysPass ? "News check" : newsOk ? "OK" : "PENDING ✗", keysPass ? COL_DIM : newsOk ? COL_BULL : COL_BEAR)
    r += 1
    if not isFocus
        if msOn
            f_dashCell(t, keysPass, r, keysPass ? "Struct int/ext" : (si.dir == 1 ? "▲" : si.dir == -1 ? "▼" : "·") + " / " + (se.dir == 1 ? "▲" : se.dir == -1 ? "▼" : "·"), keysPass ? COL_DIM : COL_TXT)
            r += 1
        if pdOn
            f_dashCell(t, keysPass, r, keysPass ? "Range pos" : pdZone + (na(pdPct) ? "" : " " + str.tostring(pdPct, "#") + "%"), keysPass ? COL_DIM : pdZone == "PREMIUM" ? COL_BEAR : pdZone == "DISCOUNT" ? COL_BULL : COL_TXT)
            r += 1
        if vwOn
            f_dashCell(t, keysPass, r, keysPass ? "VWAP σ" : na(sigmaPos) ? "n/a" : str.tostring(sigmaPos, "#.##") + "σ", keysPass ? COL_DIM : math.abs(nz(sigmaPos)) >= 2 ? COL_BRK : COL_TXT)
            r += 1
        if smtOn
            f_dashCell(t, keysPass, r, keysPass ? "SMT" : not corrOk ? "corr low ✗" : not na(lastSmtBullBi) and bar_index - lastSmtBullBi <= 20 ? "BULL div" : not na(lastSmtBearBi) and bar_index - lastSmtBearBi <= 20 ? "BEAR div" : "corr " + str.tostring(nz(corrVal), "#.##"), keysPass ? COL_DIM : corrOk ? COL_TXT : COL_BEAR)
            r += 1
    if isAnalysis
        f_dashCell(t, keysPass, r, keysPass ? "— Stats (chart)" : "n FVG " + str.tostring(stArr.get(ST_FVG_TOT)), COL_DIM)
        r += 1
        f_dashCell(t, keysPass, r, keysPass ? "FVG fill/CE/inv" : f_pct(stArr.get(ST_FVG_FILL), stArr.get(ST_FVG_TOT)) + "/" + f_pct(stArr.get(ST_FVG_CE), stArr.get(ST_FVG_TOT)) + "/" + f_pct(stArr.get(ST_FVG_INV), stArr.get(ST_FVG_TOT)), keysPass ? COL_DIM : COL_TXT)
        r += 1
        f_dashCell(t, keysPass, r, keysPass ? "FVG react 1h/10b" : f_pct(stArr.get(ST_FVG_ROK), stArr.get(ST_FVG_RTOT)) + " (n=" + str.tostring(stArr.get(ST_FVG_RTOT)) + ")", keysPass ? COL_DIM : COL_TXT)
        r += 1
        f_dashCell(t, keysPass, r, keysPass ? "OB touch/react" : str.tostring(stArr.get(ST_OB_TOUCH)) + "/" + str.tostring(stArr.get(ST_OB_ROK)) + " (n=" + str.tostring(stArr.get(ST_OB_TOT)) + ")", keysPass ? COL_DIM : COL_TXT)
        r += 1
        f_dashCell(t, keysPass, r, keysPass ? "Sweep→MSS" : "SSL " + f_pct(swpMssDn, swpTotDn) + " · BSL " + f_pct(swpMssUp, swpTotUp), keysPass ? COL_DIM : COL_TXT)
        r += 1
        [hw, hn] = f_winArgmax(hiWinCnt)
        [lw, lcnt] = f_winArgmax(loWinCnt)
        f_dashCell(t, keysPass, r, keysPass ? "DayHi/Lo window" : f_winName(hw) + " " + f_pct(hn, dayCnt) + " / " + f_winName(lw) + " " + f_pct(lcnt, dayCnt), keysPass ? COL_DIM : COL_TXT)
        r += 1
    r

var table dash = na
if dashOn and na(dash)
    dash := table.new(dashPos == "Top Right" ? position.top_right : dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Right" ? position.bottom_right : position.bottom_left, 2, 18, bgcolor = color.new(#0d1117, 15), border_width = 1, border_color = color.new(#30363d, 40), frame_width = 1, frame_color = color.new(#30363d, 20))
    int _rowsK = f_dashFill(dash, true)
if dashOn and uiTick
    int _rowsV = f_dashFill(dash, false)

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 16 · ALERTS (7 actionable conditions + rich dynamic payloads)
// ────────────────────────────────────────────────────────────────────────────────────────────────
var int lastSwpAlertBi = na
bool sweepKzEvt = false
if (sweepUpEvt or sweepDnEvt) and kzAny
    int bestR = math.min(sweepUpEvt ? sweepUpBestRank : 99, sweepDnEvt ? sweepDnBestRank : 99)
    if bestR <= alSweepRank and (na(lastSwpAlertBi) or bar_index - lastSwpAlertBi >= 5)
        sweepKzEvt := true
        lastSwpAlertBi := bar_index

bool kzOpenEvt = (inLdn and not inLdn[1]) or (inNyAm and not inNyAm[1])
bool anySetup = setupALong or setupAShort or setupBLong or setupBShort

alertcondition(setupALong, "IFTS · Setup A LONG armed", "IFTS: Setup A LONG armed (sweep + MSS + zone + P/D + RR, in kill zone)")
alertcondition(setupAShort, "IFTS · Setup A SHORT armed", "IFTS: Setup A SHORT armed (sweep + MSS + zone + P/D + RR, in kill zone)")
alertcondition(setupBLong, "IFTS · Setup B LONG trigger", "IFTS: Setup B LONG (trend regime + flip-zone reload)")
alertcondition(setupBShort, "IFTS · Setup B SHORT trigger", "IFTS: Setup B SHORT (trend regime + flip-zone reload)")
alertcondition(sweepKzEvt, "IFTS · Qualified sweep in KZ", "IFTS: rank-qualified liquidity sweep inside a kill zone — pre-alert")
alertcondition(kzOpenEvt, "IFTS · Kill zone opened", "IFTS: London / NY AM kill zone started")
alertcondition(anySetup, "IFTS · Any setup (A or B)", "IFTS: a Setup A or B signal fired")

if barstate.isconfirmed
    if alSetup and (setupALong or setupAShort)
        alert(aAlertTxt, alert.freq_once_per_bar_close)
    if alSetup and (setupBLong or setupBShort)
        alert(bAlertTxt, alert.freq_once_per_bar_close)
    if alSweep and sweepKzEvt
        alert("IFTS qualified sweep in KZ: " + (sweepUpEvt ? "BUYSIDE" : "SELLSIDE") + " rank " + str.tostring(sweepUpEvt ? sweepUpBestRank : sweepDnBestRank) + " on " + syminfo.ticker, alert.freq_once_per_bar_close)
    if alKz and kzOpenEvt
        alert("IFTS kill zone opened: " + (inLdn ? "LONDON" : "NY AM") + " · " + syminfo.ticker, alert.freq_once_per_bar_close)

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 17 · PLOTS & BACKGROUND (visibility follows the display mode)
// ────────────────────────────────────────────────────────────────────────────────────────────────
color kzShade = not kzOn ? na : inNyAm ? color.new(COL_BULL, 96) : inLdn ? color.new(COL_VWAP, 96) : inNyPm ? color.new(COL_BRK, 97) : inLunch ? color.new(COL_BEAR, 97) : na
bgcolor(kzShade, title = "Kill zone shading")

plot(vwOn ? sesVwap : na, "Session VWAP", color = color.new(COL_VWAP, 0), linewidth = 2, style = plot.style_linebr)
plot(showBandsFx ? sesVwap + sesSd : na, "VWAP +1σ", color = color.new(COL_VWAP, 70), style = plot.style_linebr)
plot(showBandsFx ? sesVwap - sesSd : na, "VWAP -1σ", color = color.new(COL_VWAP, 70), style = plot.style_linebr)
plot(showBandsFx ? sesVwap + 2 * sesSd : na, "VWAP +2σ", color = color.new(COL_VWAP, 50), style = plot.style_linebr)
plot(showBandsFx ? sesVwap - 2 * sesSd : na, "VWAP -2σ", color = color.new(COL_VWAP, 50), style = plot.style_linebr)
plot(vwRthOn ? rthVwap : na, "RTH VWAP", color = color.new(COL_VWAP, 35), style = plot.style_linebr)
plot(avWOn ? avwapW : na, "AVWAP weekly", color = color.new(COL_AVWAP, 20), style = plot.style_linebr)
plot(avMOn ? avwapM : na, "AVWAP monthly", color = color.new(COL_AVWAP, 45), style = plot.style_linebr)
plot(avSOn ? avwapS : na, "AVWAP ext-MSS", color = color.new(COL_IFVG, 30), style = plot.style_linebr)
plot(avCOn ? avwapC : na, "AVWAP custom", color = color.new(COL_BRK, 30), style = plot.style_linebr)

plot(showOpensFx and not newNyDay ? midnightOpen : na, "Midnight open", color = color.new(COL_TXT, 60), style = plot.style_linebr)
plot(showOpensFx and not newRth ? rthOpen : na, "RTH open", color = color.new(COL_BULL, 65), style = plot.style_linebr)
plot(showOpensFx and not newWeek ? weeklyOpen : na, "Weekly open", color = color.new(COL_BRK, 60), style = plot.style_linebr)

bool sweepMkUp = liqOn and sweepUpEvt and (not isFocus or kzAny)
bool sweepMkDn = liqOn and sweepDnEvt and (not isFocus or kzAny)
plotshape(sweepMkDn, "Sellside sweep", style = shape.triangleup, location = location.belowbar, color = color.new(COL_POOL, 25), size = size.tiny)
plotshape(sweepMkUp, "Buyside sweep", style = shape.triangledown, location = location.abovebar, color = color.new(COL_POOL, 25), size = size.tiny)
plotshape(setupBLong, "Setup B long", style = shape.labelup, location = location.belowbar, color = color.new(COL_BULL, 20), size = size.tiny, text = "B", textcolor = color.white)
plotshape(setupBShort, "Setup B short", style = shape.labeldown, location = location.abovebar, color = color.new(COL_BEAR, 20), size = size.tiny, text = "B", textcolor = color.white)

// UI throttle latch (must stay the last statement block)
if uiTick
    renderedOnce := true
