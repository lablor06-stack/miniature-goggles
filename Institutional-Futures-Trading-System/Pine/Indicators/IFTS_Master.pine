//@version=6
// ═══════════════════════════════════════════════════════════════════════════════════════════════
//  IFTS — INSTITUTIONAL FUTURES TRADING SYSTEM · MASTER · DECISION SUPPORT SYSTEM
//  Version 3.1.0 · Pine Script v6 · Target: CME index futures (ES/NQ), chart TF M1–H1
//
//  v3.1.0 — execution platform upgrade (signal logic untouched):
//    · SETUP QUALITY ENGINE: 13 weighted components → 0-100 → class A+ (≥95) / A (≥90) /
//      B (≥80) / IGNORE (<80); classes drive emphasis, never signal generation
//    · MULTI-TIMEFRAME CONTEXT: H4/H1/M15/M5 bias, alignment feeds the score
//    · SMART ZONE SELECTION: FVGs and OBs ranked by quality (size/freshness/mitigation/
//      confluence/proximity) — only the strongest candidate per side is drawn
//    · AUTOMATIC CHECKLIST (Explain mode toggle — Pine has no hover events): ✓/✗ per
//      requirement + WAIT/READY summary
//    · TRADE LIFECYCLE: Entered → Break Even → Partial → Runner → Closed (MFE-based)
//    · AUTO-JOURNAL (chart sample): every completed setup recorded internally; aggregates
//      shown in Analysis. The written journal remains the record of truth.
//    · SMART ALERTS: dynamic payloads now carry confidence and class
//
//  v3.0.0 — state-driven core:
//    · finite state machine (9 states) narrates the trade lifecycle; ONE state at a time
//    · execution panel: DIRECTION · CONFIDENCE · STATUS · NEXT · E/S/T · RR
//    · adaptive visibility per state: liquidity → sweep → entry zone → E/S/T → clean chart
//    · trade tracker with visual outcome (target/stop/session-end) and full object cleanup
//    · modes: EXECUTION (default) · ANALYSIS (analytical objects) · DEBUG (internals)
//
//  UNCHANGED vs v2.x (logic layer): signal conditions, FVG/OB/sweep/SMT/VWAP/regime
//  calculations, grading, statistics, all 7 alertconditions and dynamic alert payloads.
//  The FSM and confidence engine are INTERPRETATION layers on top of existing events.
//
//  Architecture:  SIGNAL ENGINE → STATE MACHINE → CONFIDENCE ENGINE → OBJECT MANAGER
//                 → RENDERING ENGINE → EXECUTION / ANALYSIS / DEBUG UI
//  Rules: no rendering inside signal code · no calculations inside drawing functions ·
//         every object has creation / update / expiration / deletion · no ghosts.
//
//  Contract: events on barstate.isconfirmed only (no repaint) · lookahead_off everywhere ·
//  clock pinned to America/New_York · functions never assign globals · defaults = P1..P17.
// ═══════════════════════════════════════════════════════════════════════════════════════════════
indicator("IFTS — Institutional Futures Trading System [Master]", "IFTS Master", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, dynamic_requests = true)

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 1 · PALETTE (5 semantic colors) · CONSTANTS · CONFIDENCE WEIGHTS
// ────────────────────────────────────────────────────────────────────────────────────────────────
string NYTZ = "America/New_York"

color COL_BULL = #4c9a70
color COL_BEAR = #c65b5b
color COL_NEUT = #787b86
color COL_VWAP = #e0e3eb
color COL_LIQ  = #d4b96a

color ZBG_BULL = color.new(COL_BULL, 88)
color ZBR_BULL = color.new(COL_BULL, 60)
color ZBG_BEAR = color.new(COL_BEAR, 88)
color ZBR_BEAR = color.new(COL_BEAR, 60)
color ZBG_NEUT = color.new(COL_NEUT, 90)
color ZBR_NEUT = color.new(COL_NEUT, 68)
color LIQ_RAY  = color.new(COL_LIQ, 45)
color LIQ_TXT  = color.new(COL_LIQ, 25)

int Z_FVG = 1
int Z_OB  = 2
int Z_MIT = 3
int Z_BRK = 4
int Z_IFV = 5

// finite market states
int S_IDLE = 0
int S_WAIT_LIQ = 1
int S_LIQ_TAKEN = 2
int S_WAIT_MSS = 3
int S_STRUCT_OK = 4
int S_WAIT_RETRACE = 5
int S_ENTRY_READY = 6
int S_TRADE_ACTIVE = 7
int S_TRADE_CLOSED = 8

// SETUP QUALITY ENGINE weights (sum = 100) — breakdown visible in Explain/Debug only.
// Classes: ≥95 A+ · ≥90 A · ≥80 B · <80 IGNORE. Classes drive EMPHASIS (line weight,
// panel badge, alert text); they never gate signal generation or alerts.
float W_BIAS = 15.0   // H4 bias agreement (neutral = half)
float W_MTF  = 10.0   // H1/M15/M5 alignment with the hypothesis
float W_SWP  = 12.0   // qualified liquidity sweep behind the move
float W_MSS  = 15.0   // structure shift confirmed
float W_SMT  = 8.0    // recent same-side SMT divergence
float W_PD   = 8.0    // entry in the favorable half of the dealing range
float W_VWAP = 5.0    // price on the favorable side of session VWAP
float W_SESS = 8.0    // session quality (NY AM 8 · London 7 · PM 4 · lunch 0 · other 2)
float W_OBQ  = 4.0    // order-block backing of the entry zone
float W_FVGQ = 5.0    // entry FVG quality (size/freshness/confluence/proximity)
float W_RR   = 5.0    // risk:reward (≥ minRr full · ≥1 partial)
float W_VOL  = 3.0    // volatility sanity (day range vs ADR inside the useful band)
float W_REC  = 2.0    // recency of the structural confirmation

int CLOSED_SHOW_BARS = 10   // how long state 8 stays on the panel before returning to idle

// statistics slots
int ST_FVG_TOT  = 0
int ST_FVG_CE   = 1
int ST_FVG_FILL = 2
int ST_FVG_INV  = 3
int ST_FVG_ROK  = 4
int ST_FVG_RTOT = 5
int ST_OB_TOT   = 6
int ST_OB_TOUCH = 7
int ST_OB_ROK   = 8
var array<int> stArr = array.new<int>(9, 0)

// ────────────────────────────────────────────────────────────────────────────────────────────────
// 2 · INPUTS
// ────────────────────────────────────────────────────────────────────────────────────────────────
string GEN = "General"
string dispMode = input.string("Execution", "Display mode", options = ["Execution", "Analysis", "Debug"], group = GEN, tooltip = "EXECUTION (default): state-driven minimal chart + execution panel — the indicator interprets, you execute. ANALYSIS: all analytical objects (zones, pools, bands, key opens, statistics). DEBUG: Analysis + every internal (state id, confidence breakdown, engine memories). Never trade in Debug.")
bool sigOn      = input.bool(true, "Signal engine (Setup A / B)", group = GEN, tooltip = "Composite signals per the Core Model; also drives the state machine and the execution panel. Setup A needs the FVG engine; Setup B needs OB and/or FVG engines.")
bool biasOn     = input.bool(true, "HTF bias filter", group = GEN, tooltip = "External-structure direction on the bias timeframe, with hysteresis. Feeds direction hypothesis and confidence.")
string biasTf   = input.timeframe("240", "Bias timeframe", group = GEN, tooltip = "H4 default per Conventions §3.")
bool regimeOn   = input.bool(true, "Day-regime classifier", group = GEN, tooltip = "Rotation / Trend / Chop heuristic. Gates signals; the trader owns the final call.")
bool pdOn       = input.bool(true, "Dealing range (premium/discount)", group = GEN, tooltip = "Algorithmic dealing range from external swings. Enforces the V6 gate on Setup A and feeds confidence. EQ line drawn in Analysis mode only.")
bool explainOn  = input.bool(false, "Explain mode (checklist + score breakdown)", group = GEN, tooltip = "Appends the automatic checklist (✓/✗ per requirement, WAIT/READY summary) and the quality components to the panel. Learning/validation aid — keep OFF while executing. Pine has no hover events, hence a toggle.")
bool mtfOn      = input.bool(true, "Multi-timeframe context (H1/M15/M5)", group = GEN, tooltip = "Directional bias of H1, M15 and M5 alongside the H4 bias; alignment feeds the quality score and the MTF panel row. Three additional security calls.")

string MSG = "Market Structure"
bool msOn      = input.bool(true, "Enable structure engine", group = MSG, tooltip = "Swings, BOS, CHoCH, MSS on two scales. Required by liquidity, zones, signals, SMT.")
int  msIntLen  = input.int(3, "Internal swing length (P1)", minval = 2, maxval = 10, group = MSG, tooltip = "Confirmed N bars after the extreme — structural, unavoidable lag.")
int  msExtLen  = input.int(8, "External swing length (P2)", minval = 5, maxval = 25, group = MSG)
bool msShowInt = input.bool(true, "Show internal events", group = MSG, tooltip = "Execution: only the narrative-relevant current MSS. Analysis: full history within caps.")
bool msShowExt = input.bool(true, "Show external events", group = MSG)

string LIQ = "Liquidity"
bool liqOn   = input.bool(true, "Enable liquidity engine", group = LIQ, tooltip = "Pools are always TRACKED for the engine; the state machine decides what is DRAWN.")
bool liqPdw  = input.bool(true, "Daily & weekly pools (PDH/PDL, PWH/PWL)", group = LIQ)
bool liqSess = input.bool(true, "Session extreme pools (Asia, London)", group = LIQ)
bool liqShow = input.bool(true, "Draw pool rays", group = LIQ, tooltip = "Execution draws only PDH · PDL · Asia H/L, and hides them while a trade is active. Consumed pools are deleted instantly.")

string OBG = "Order Blocks"
bool obOn       = input.bool(true, "Enable OB / Breaker / Mitigation", group = OBG, tooltip = "Logic layer for Setup B and composite grading. OB boxes are drawn in Analysis mode; Execution communicates through the panel instead.")
