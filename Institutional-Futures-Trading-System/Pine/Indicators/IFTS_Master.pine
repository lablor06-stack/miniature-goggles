int  alSweepRank = input.int(3, "Max pool rank for sweep alert", minval = 1, maxval = 4, group = ALR)
bool alKz        = input.bool(false, "Kill-zone open", group = ALR)

string PRF = "Performance"
int  perfDrawLb   = input.int(1000, "Drawing window (bars back)", minval = 200, maxval = 5000, group = PRF)
int  perfPoolMax  = input.int(24, "Max pools tracked", minval = 8, maxval = 80, group = PRF)
int  perfFvgMax   = input.int(14, "Max FVG zones tracked", minval = 4, maxval = 60, group = PRF)
int  perfObMax    = input.int(10, "Max OB-family zones tracked", minval = 4, maxval = 40, group = PRF)
