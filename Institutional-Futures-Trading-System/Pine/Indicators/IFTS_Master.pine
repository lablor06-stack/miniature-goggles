float corrMin   = input.float(0.55, "Minimum returns-correlation", minval = 0.0, maxval = 1.0, step = 0.05, group = SMT, tooltip = "Correlation of bar returns (price-level correlation is spuriously ~1).")
bool smtAtPools = input.bool(true, "Only at liquidity pools", group = SMT)

string DSH = "Execution Panel"
bool dashOn    = input.bool(true, "Show execution panel", group = DSH, tooltip = "DIRECTION · CONFIDENCE · STATUS · NEXT · Entry/Stop/Target. Analysis appends statistics; Debug appends internals. Refreshes on bar close.")
string dashPos = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = DSH)
string dashSz  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = DSH)

string ALR = "Alerts"
bool alSetup     = input.bool(true, "Setup A / B alerts (rich payload)", group = ALR)
